# Copy to .env, then append FASHION_FINDER_SECRET_KEY=<random value>.
FASHION_FINDER_DATA_DIR=./data
FASHION_FINDER_API_PORT=8000
FASHION_FINDER_WEB_PORT=3000
# On Linux/WSL, set these to `id -u` and `id -g` if they differ from 1000.
FASHION_FINDER_UID=1000
FASHION_FINDER_GID=1000
# Set to 1 only after reviewing the local privacy and retention instructions.
FASHION_FINDER_ANALYTICS_ENABLED=0
# Set to 1 only for a local image-index experiment with approved source policy.
FASHION_FINDER_IMAGE_SEARCH_EXPERIMENT=0
