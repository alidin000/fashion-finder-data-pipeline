FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FASHION_FINDER_DB=/data/fashion_finder.sqlite \
    FASHION_FINDER_STATIC_ROOT=/app/staticfiles \
    FASHION_FINDER_SERVE_STATIC=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
ARG FASHION_FINDER_INSTALL_IMAGE_MODEL=0
RUN if [ "$FASHION_FINDER_INSTALL_IMAGE_MODEL" = "1" ]; then \
      python -m pip install --no-cache-dir '.[image-model]'; \
    else \
      python -m pip install --no-cache-dir .; \
    fi
COPY manage.py ./
COPY scripts/render-api-start.sh ./scripts/
# The hosted listing policy (render.yaml points FASHION_FINDER_SOURCE_POLICIES at it).
COPY config/source-policies.render-listing.json ./config/
RUN python manage.py collectstatic --noinput
# Render SSH and shell sessions need a named user with a shell and ~/.ssh.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && install -d -m 0700 -o 1000 -g 1000 /home/app/.ssh

USER 1000:1000
EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "fashion_finder_data.django_project.wsgi:application"]
