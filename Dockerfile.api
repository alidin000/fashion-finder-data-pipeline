FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FASHION_FINDER_DB=/data/fashion_finder.sqlite \
    FASHION_FINDER_STATIC_ROOT=/app/staticfiles \
    FASHION_FINDER_SERVE_STATIC=1

WORKDIR /app
# FASHION_FINDER_INSTALL_IMAGE_MODEL=1 (Render passes service env vars as build args) adds
# photo search: ONNX Runtime and the pinned Marqo-FashionSigLIP INT8 vision model
# (Apache-2.0, 94 MB) at /app/models/. The build fails unless the file has the pinned
# SHA-256. Without the argument nothing is downloaded and the image stays as before.
# The model comes before the source code, so a code change does not download it again.
ARG FASHION_FINDER_INSTALL_IMAGE_MODEL=0
RUN if [ "$FASHION_FINDER_INSTALL_IMAGE_MODEL" = "1" ]; then \
      model=/app/models/fashion-siglip-vision-int8.onnx \
      && mkdir -p /app/models \
      && python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
        "https://huggingface.co/Marqo/marqo-fashionSigLIP/resolve/c56244cc94f92419e8369fa71efdaf403b124ce8/onnx/vision_model_quantized.onnx" \
        "$model" \
      && sha256sum "$model" \
      && echo "f1009cfce0eedd409f601e8351eedab72e8529641105eee6517821a9a634a2f4  $model" \
        | sha256sum --check --strict; \
    fi
COPY pyproject.toml README.md ./
COPY src ./src
RUN if [ "$FASHION_FINDER_INSTALL_IMAGE_MODEL" = "1" ]; then \
      python -m pip install --no-cache-dir '.[image-model]'; \
    else \
      python -m pip install --no-cache-dir .; \
    fi
COPY manage.py ./
COPY scripts/render-api-start.sh ./scripts/
# The hosted listing policy (render.yaml points FASHION_FINDER_SOURCE_POLICIES at it).
COPY config/source-policies.render-listing.json ./config/
RUN python manage.py collectstatic --noinput
# Render SSH and shell sessions need a named user with a shell and ~/.ssh.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && install -d -m 0700 -o 1000 -g 1000 /home/app/.ssh

USER 1000:1000
EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "fashion_finder_data.django_project.wsgi:application"]
